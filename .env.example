# ── The agent ────────────────────────────────────────────────────────────
# Optional. Without it FoodFlow runs on its local rules engine and the whole
# customer demo still works end to end — discovery, cart, authorisation, collection.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Telegram merchant onboarding ─────────────────────────────────────────
# Get a token from @BotFather. Reading menu photos also needs OPENAI_API_KEY above.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Where published menus persist ────────────────────────────────────────
# Vercel KV or Upstash (both free tier). Without these, menus published from
# Telegram live in memory on the running instance only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
